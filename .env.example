# Copia como .env y completa localmente. Nunca confirmes .env al repositorio.
SICOSE_SECRET_KEY=
SICOSE_DATABASE=instance/sicose.sqlite3
SICOSE_SESSION_COOKIE_SECURE=false

# Seed de desarrollo: usuario inequívocamente DEMO. Define una contraseña local
# robusta (mínimo 12 caracteres); el comando seed no la imprime ni la almacena en claro.
SICOSE_ADMIN_USERNAME=admin.demo
SICOSE_ADMIN_PASSWORD=
